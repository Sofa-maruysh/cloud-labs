# Учебный антипример. В Compose этот образ не используется.
# 1. Плавающий тег и полный Debian с инструментами, которые сервису не нужны.
FROM python:3.12
WORKDIR /app
# 2. Копируем всё до установки зависимостей: одна строка кода сбрасывает кеш pip.
# 3. Отдельный ignore пустой, поэтому лишние файлы тоже попадут в образ.
COPY . .
# 4. Кеш pip остаётся внутри слоя; сборка и запуск в одной стадии.
RUN pip install -r requirements.txt
# 5. Не задан USER: процесс работает от root.
# 6. Нет HEALTHCHECK: Docker видит процесс, но не проверяет API и БД.
EXPOSE 5000
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--threads", "2", "--timeout", "30", "--access-logfile", "-", "--error-logfile", "-", "app:app"]
